# Supabase project settings (Dashboard -> Project Settings -> API Keys)
# Copy this file to ".env" and paste your own values.
# Publishable key = the new "sb_publishable_..." key (safe in app code; RLS protects data)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE
