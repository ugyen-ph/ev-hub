# Supabase project settings (Dashboard -> Project Settings -> API / Data API)
# Project URL - looks like https://abcd1234.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable key (new key system) - starts with sb_publishable_
# Safe to ship in the app: Row Level Security protects the data.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE
