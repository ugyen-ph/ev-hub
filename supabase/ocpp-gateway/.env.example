# ============================================
# EV Hub Bhutan - OCPP Gateway Configuration
# Copy this file to .env and fill in your values
# ============================================

# Supabase Configuration
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Gateway Configuration
# Port that chargers will connect to
GATEWAY_PORT=8080

# TLS (optional, wss://). Set BOTH to serve https+wss from the gateway itself;
# otherwise terminate TLS on a reverse proxy (nginx/caddy) in front of it.
# TLS_KEY_PATH=/etc/letsencrypt/live/ocpp.example.com/privkey.pem
# TLS_CERT_PATH=/etc/letsencrypt/live/ocpp.example.com/fullchain.pem

# OCPP Configuration
OCPP_VERSION=1.6
HEARTBEAT_INTERVAL=60

# Offline watchdog: OCPP chargers silent for this long are marked 'offline'
OFFLINE_AFTER_MINUTES=10
OFFLINE_SWEEP_SECONDS=60

# Fallback price (Nu per kWh) when a station has no tariff configured.
# Real tariffs come from stations.tariff_nu_per_kwh (migration 0007).
TARIFF_FALLBACK_NU=5

# Charger Authentication (add your BPC chargers here)
# Format: charge_point_id:password
# OCPP 1.6J security profile 1: chargers connect with HTTP Basic auth,
# username = charge point id. Only enforced when DEMO_MODE=false.
# Example: BPC-THIM-001:secret123
CHARGERS=BPC-THIM-001:test123,BPC-THIM-002:test456

# Demo Mode (set to false when connecting real chargers)
DEMO_MODE=true
