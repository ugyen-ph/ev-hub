# ============================================
# EV Hub Bhutan - OCPP Gateway Configuration
# Copy this file to .env and fill in your values
# ============================================

# Supabase Configuration
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Gateway Configuration
# Port that chargers will connect to
GATEWAY_PORT=8080

# OCPP Configuration
OCPP_VERSION=1.6
HEARTBEAT_INTERVAL=60

# Charger Authentication (add your BPC chargers here)
# Format: charge_point_id:password
# Example: BPC-THIM-001:secret123
CHARGERS=BPC-THIM-001:test123,BPC-THIM-002:test456

# Demo Mode (set to false when connecting real chargers)
DEMO_MODE=true
